+                              const lv_draw_border_dsc_t * border)
+{
+    if(area->x1 > area->x2 || area->y1 > area->y2) return true;
+    lv_draw_fill_dsc_t fill;
+    lv_draw_fill_dsc_init(&fill);
+    fill.color = border->color;
+    fill.opa = border->opa;
+    lv_draw_task_t strip = *original;
+    strip.type = LV_DRAW_TASK_TYPE_FILL;
+    strip.draw_dsc = &fill;
+    strip.area = *area;
+    strip._real_area = *area;
+    return draw_solid_fill(&strip);
+}
+
+static bool draw_straight_border(lv_draw_task_t * t, const lv_draw_border_dsc_t * border)
+{
+    if(border->radius != 0) return false;
+    if(border->width <= 0 || border->side == LV_BORDER_SIDE_NONE) return true;
+    lv_area_t area = t->area;
+    int32_t width = lv_area_get_width(&area);
+    int32_t height = lv_area_get_height(&area);
+    int32_t left = (border->side & LV_BORDER_SIDE_LEFT) ? LV_MIN(border->width, width) : 0;
+    int32_t right = (border->side & LV_BORDER_SIDE_RIGHT) ? LV_MIN(border->width, width - left) : 0;
+    int32_t top = (border->side & LV_BORDER_SIDE_TOP) ? LV_MIN(border->width, height) : 0;
+    int32_t bottom = (border->side & LV_BORDER_SIDE_BOTTOM) ? LV_MIN(border->width, height - top) : 0;
+    /* Disjoint strips prevent corners from receiving opacity twice. */
+    lv_area_t strip = {area.x1, area.y1, area.x2, area.y1 + top - 1};
+    if(!draw_border_strip(t, &strip, border)) return false;
+    strip = (lv_area_t){area.x1, area.y2 - bottom + 1, area.x2, area.y2};
+    if(!draw_border_strip(t, &strip, border)) return false;
+    strip = (lv_area_t){area.x1, area.y1 + top, area.x1 + left - 1, area.y2 - bottom};
+    if(!draw_border_strip(t, &strip, border)) return false;
+    strip = (lv_area_t){area.x2 - right + 1, area.y1 + top, area.x2, area.y2 - bottom};
+    return draw_border_strip(t, &strip, border);
+}
+
+static bool draw_solid_fill(lv_draw_task_t * t)
+{
+    lv_color_t color;
+    lv_opa_t opacity;
+    int32_t radius, border_width = 0;
+    const lv_grad_dsc_t * gradient = NULL;
+    if(t->type == LV_DRAW_TASK_TYPE_FILL) {
+        const lv_draw_fill_dsc_t * fill = t->draw_dsc;
+        if(fill->grad.dir != LV_GRAD_DIR_NONE) {
+            if((fill->grad.dir != LV_GRAD_DIR_HOR && fill->grad.dir != LV_GRAD_DIR_VER) ||
+               fill->grad.extend != LV_GRAD_EXTEND_PAD || fill->grad.stops_count != 2) return false;
+            int32_t extent = fill->grad.dir == LV_GRAD_DIR_HOR ? lv_area_get_width(&t->area) : lv_area_get_height(&t->area);
+            if(((fill->grad.stops[1].frac * extent) >> 8) <= ((fill->grad.stops[0].frac * extent) >> 8)) return false;
+            gradient = &fill->grad;
+        }
+        color = fill->color;
+        opacity = fill->opa;
+        radius = fill->radius;
+    }
+    else if(t->type == LV_DRAW_TASK_TYPE_BORDER) {
+        const lv_draw_border_dsc_t * border = t->draw_dsc;
+        if(border->side != LV_BORDER_SIDE_FULL) return draw_straight_border(t, border);
+        if(border->width <= 0) return true;
+        color = border->color;
+        opacity = border->opa;
+        radius = border->radius;
+        border_width = border->width;
+    }
+    else return false;
+    lv_draw_opengles_unit_t * unit = (lv_draw_opengles_unit_t *)t->draw_unit;
+    lv_layer_t * layer = t->target_layer;
+    unsigned int texture = layer_get_texture(layer);
+    if(!texture) return false;
+    unsigned int framebuffer = get_framebuffer(unit);
+    GL_CALL(glBindFramebuffer(GL_FRAMEBUFFER, framebuffer));
+    GL_CALL(glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0));
+    int32_t width = lv_area_get_width(&layer->buf_area);
+    int32_t height = lv_area_get_height(&layer->buf_area);
+    lv_opengles_viewport(0, 0, width, height);
+    lv_area_t area = t->area;
+    lv_area_t clip = t->clip_area;
+    lv_area_move(&area, -layer->buf_area.x1, -layer->buf_area.y1);
+    lv_area_move(&clip, -layer->buf_area.x1, -layer->buf_area.y1);
+    lv_opengles_render_params_t params;
+    lv_opengles_render_params_init(&params);
+    params.texture_area = &area;
+    params.texture_clip_area = &clip;
+    params.disp_w = width;
+    params.disp_h = height;
+    params.fill_color = color;
+    params.shape_border_width = border_width;
+    if(gradient) {
+        params.shape_gradient_dir = gradient->dir;
+        int32_t extent = gradient->dir == LV_GRAD_DIR_HOR ? lv_area_get_width(&area) : lv_area_get_height(&area);
+        for(int i = 0; i < 2; ++i) {
+            params.shape_gradient_colors[i] = gradient->stops[i].color;
+            params.shape_gradient_stops[i] = (gradient->stops[i].frac * extent) >> 8;
+            params.shape_gradient_opacity[i] = gradient->stops[i].opa / 255.f;
+        }
+    }
+    int32_t half = LV_MIN(lv_area_get_width(&area), lv_area_get_height(&area)) / 2;
+    params.blur_corner_radius = LV_MIN(radius, half);
+    params.opa = opacity;
+    params.rb_swap = true;
+    lv_opengles_render(&params);
+    return true;
+}
+
+
+static uint64_t native_font_generation(const lv_font_t * font)
+{
+#if LV_USE_FREETYPE
+    return lv_freetype_bitmap_font_get_cache_id(font);
+#else
+    LV_UNUSED(font);
+    return 0;
+#endif
+}
+
+static bool native_bitmap_font_supported(const lv_font_t * font)
+{
+    return font->get_glyph_dsc == lv_font_get_glyph_dsc_fmt_txt || native_font_generation(font) != 0;
+}
+
+typedef struct {
+    const lv_font_t * font;
+    uint64_t font_generation;
+    uint32_t glyph;
+    uint32_t color;
+    int width, height;
+    unsigned int texture;
+    int x, y;
+} native_glyph_t;
+static native_glyph_t native_glyphs[4096];
+static bool native_glyph_key_matches(const native_glyph_t * entry, const lv_font_t * font,
+                                     uint64_t generation, uint32_t glyph, uint32_t color,
+                                     int width, int height)
+{
+    return entry->texture && entry->font == font && entry->font_generation == generation &&
+           entry->glyph == glyph && entry->color == color && entry->width == width && entry->height == height;
+}
+
+static unsigned int native_atlas_texture;
+static unsigned int native_atlas_pages[16];
+static unsigned int native_batch_texture;
+static int native_atlas_size;
+static unsigned int native_atlas_page, native_atlas_page_count;
+
+static void native_atlas_configure(void)
+{
+    if(native_atlas_size) return;
+    const char * renderer = (const char *)glGetString(GL_RENDERER);
+    bool mali = renderer && strstr(renderer, "Mali");
+    native_atlas_size = mali ? 512 : 2048;
+    native_atlas_page_count = mali ? 16 : 1;
+}
+
+static int native_atlas_x, native_atlas_y, native_atlas_row;
+static float native_vertices[1024*6*4];
+static unsigned native_vertex_count;
+static lv_draw_task_t * native_batch_task;
+static lv_opa_t native_batch_opa;
+static void native_label_flush(void)
+{
+    if(!native_vertex_count) return;
+    lv_layer_t * layer=native_batch_task->target_layer;
+    int width=lv_area_get_width(&layer->buf_area);
+    int height=lv_area_get_height(&layer->buf_area);
+    lv_area_t area={0,0,width-1,height-1};
+    lv_opengles_render_params_t params;
+    lv_opengles_render_params_init(&params);
+    params.texture=native_batch_texture;
+    params.texture_area=&area; params.texture_clip_area=&area;
+    params.disp_w=width; params.disp_h=height;
+    params.opa=native_batch_opa;
+    params.batch_vertices=native_vertices;
+    params.batch_vertex_count=native_vertex_count;
+    lv_opengles_render(&params);
+    native_vertex_count=0;
+}
+static bool native_label_checking;
+static bool native_label_supported;
+
+static void native_glyph_cleanup(void)
+{
+    for(unsigned i=0;i<16;++i)
+        if(native_atlas_pages[i]) glDeleteTextures(1,&native_atlas_pages[i]);
+    lv_memzero(native_atlas_pages,sizeof(native_atlas_pages));
+    native_atlas_size=0;
+    native_atlas_page=native_atlas_page_count=0;
+    native_batch_texture=0;
+    native_atlas_texture=0;
+    native_atlas_x=native_atlas_y=native_atlas_row=0;
+    native_vertex_count=0;
+    lv_memzero(native_glyphs,sizeof(native_glyphs));
+}
+
+static void native_label_glyph(lv_draw_task_t * t, lv_draw_glyph_dsc_t * glyph,
+                               lv_draw_fill_dsc_t * fill, const lv_area_t * fill_area)
+{
+    if(fill && fill_area) { native_label_supported=false; return; }
+    if(!glyph || !glyph->g || !glyph->letter_coords) return;
+    if(!glyph->g->box_w || !glyph->g->box_h) return;
+    if(glyph->rotation || glyph->outline_stroke_width ||
+       !native_bitmap_font_supported(glyph->g->resolved_font) ||
+       (glyph->format != LV_FONT_GLYPH_FORMAT_A1 && glyph->format != LV_FONT_GLYPH_FORMAT_A2 &&
+        glyph->format != LV_FONT_GLYPH_FORMAT_A3 && glyph->format != LV_FONT_GLYPH_FORMAT_A4 &&
+        glyph->format != LV_FONT_GLYPH_FORMAT_A8)) {
+        native_label_supported=false; return;
+    }
+    native_atlas_configure();
+    if(glyph->g->box_w > native_atlas_size-2 || glyph->g->box_h > native_atlas_size-2) {
+        native_label_supported=false; return;
+    }
+    if(native_label_checking || !native_label_supported) return;
+    int width=glyph->g->box_w, height=glyph->g->box_h;
+    uint32_t color=lv_color_to_u32(glyph->color);
+    uint64_t generation=native_font_generation(glyph->g->resolved_font);
+    uintptr_t hash=(uintptr_t)glyph->g->resolved_font;
+    hash ^= (uintptr_t)generation * 2654435761u;
+    hash=(hash>>4) ^ ((uintptr_t)glyph->g->gid.index*2654435761u) ^ color;
+    unsigned first=hash%4096;
+    native_glyph_t * cached=&native_glyphs[first];
+    /* Keep colliding font/colour combinations resident instead of evicting on every draw. */
+    for(unsigned probe=0;probe<16;++probe) {
+        native_glyph_t * slot=&native_glyphs[(first+probe)%4096];
+        if(!slot->texture || native_glyph_key_matches(slot,glyph->g->resolved_font,generation,glyph->g->gid.index,color,width,height)) {
+            cached=slot;
+            break;
+        }
+    }
+    if(!native_glyph_key_matches(cached,glyph->g->resolved_font,generation,glyph->g->gid.index,color,width,height)) {
+        glyph->g->req_raw_bitmap=0;
+        const lv_draw_buf_t * bitmap=lv_font_get_glyph_bitmap(glyph->g,glyph->_draw_buf);
+        if(!bitmap || bitmap->header.cf!=LV_COLOR_FORMAT_A8) { native_label_supported=false; return; }
+        uint8_t * pixels=lv_malloc((size_t)width*height*4);
+        if(!pixels) { native_label_supported=false; return; }
+        for(int y=0;y<height;++y) for(int x=0;x<width;++x) {
+            uint8_t * pixel=pixels+((size_t)y*width+x)*4;
+            pixel[0]=glyph->color.blue;
+            pixel[1]=glyph->color.green;
+            pixel[2]=glyph->color.red;
+            pixel[3]=bitmap->data[(size_t)y*bitmap->header.stride+x];
+        }
+        if(!native_atlas_texture) {
+            native_atlas_texture=create_texture(native_atlas_size,native_atlas_size,NULL);
+            native_atlas_pages[native_atlas_page]=native_atlas_texture;
+        }
+        if(native_atlas_x+width+1>native_atlas_size) {
+            native_atlas_x=0; native_atlas_y+=native_atlas_row; native_atlas_row=0;
+        }
+        if(native_atlas_y+height+1>native_atlas_size) {
+            native_label_flush();
+            native_atlas_page=(native_atlas_page+1)%native_atlas_page_count;
+            unsigned int victim=native_atlas_pages[native_atlas_page];
+            for(unsigned i=0;i<4096;++i)
+                if(native_glyphs[i].texture==victim) native_glyphs[i].texture=0;
+            cached=&native_glyphs[first];
+            native_atlas_x=native_atlas_y=native_atlas_row=0;
+            if(native_atlas_page_count==1) {
+                glBindTexture(GL_TEXTURE_2D,native_atlas_texture);
+                glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA,native_atlas_size,native_atlas_size,
+                             0,GL_RGBA,GL_UNSIGNED_BYTE,NULL);
+            }
+            else {
+                if(victim) glDeleteTextures(1,&victim);
+                native_atlas_texture=create_texture(native_atlas_size,native_atlas_size,NULL);
+                native_atlas_pages[native_atlas_page]=native_atlas_texture;
+            }
+        }
+        if(!native_atlas_texture) { lv_free(pixels); native_label_supported=false; return; }
+        cached->x=native_atlas_x; cached->y=native_atlas_y;
+        glBindTexture(GL_TEXTURE_2D,native_atlas_texture);
+        glPixelStorei(GL_UNPACK_ALIGNMENT,1);
+        glTexSubImage2D(GL_TEXTURE_2D,0,cached->x,cached->y,width,height,GL_RGBA,GL_UNSIGNED_BYTE,pixels);
+        cached->texture=native_atlas_texture;
+        native_atlas_x+=width+1;
+        native_atlas_row=LV_MAX(native_atlas_row,height+1);
+        lv_free(pixels);
+        cached->font=glyph->g->resolved_font; cached->font_generation=generation; cached->glyph=glyph->g->gid.index;
+        cached->color=color; cached->width=width; cached->height=height;
+    }
+    lv_layer_t * layer=t->target_layer;
+    lv_area_t clipped;
+    if(!lv_area_intersect(&clipped,glyph->letter_coords,&t->clip_area)) return;
+    int layer_width=lv_area_get_width(&layer->buf_area);
+    int layer_height=lv_area_get_height(&layer->buf_area);
+    float x1=2.f*(clipped.x1-layer->buf_area.x1)/layer_width-1.f;
+    float x2=2.f*(clipped.x2+1-layer->buf_area.x1)/layer_width-1.f;
+    float y1=2.f*(clipped.y1-layer->buf_area.y1)/layer_height-1.f;
+    float y2=2.f*(clipped.y2+1-layer->buf_area.y1)/layer_height-1.f;
+    float u1=(cached->x+clipped.x1-glyph->letter_coords->x1)/(float)native_atlas_size;
+    float u2=(cached->x+clipped.x2+1-glyph->letter_coords->x1)/(float)native_atlas_size;
+    float v1=(cached->y+clipped.y1-glyph->letter_coords->y1)/(float)native_atlas_size;
+    float v2=(cached->y+clipped.y2+1-glyph->letter_coords->y1)/(float)native_atlas_size;
+    if(native_vertex_count+6>1024*6 || (native_vertex_count && (native_batch_opa!=glyph->opa || native_batch_texture!=cached->texture))) native_label_flush();
+    native_batch_opa=glyph->opa;
+    native_batch_texture=cached->texture;
+    float vertices[24]={x1,y1,u1,v1, x2,y1,u2,v1, x2,y2,u2,v2,
+                        x1,y1,u1,v1, x2,y2,u2,v2, x1,y2,u1,v2};
+    lv_memcpy(native_vertices+native_vertex_count*4,vertices,sizeof(vertices));
+    native_vertex_count+=6;
+}
+
+static bool draw_native_label(lv_draw_task_t * t)
+{
+    if(t->type!=LV_DRAW_TASK_TYPE_LABEL) return false;
+    const lv_draw_label_dsc_t * label=t->draw_dsc;
+    if(label->rotation || label->decor || label->outline_stroke_width ||
+       label->sel_start!=LV_DRAW_LABEL_NO_TXT_SEL || label->sel_end!=LV_DRAW_LABEL_NO_TXT_SEL) return false;
+    native_label_supported=true;
+    native_label_checking=true;
+    lv_draw_label_iterate_characters(t,label,&t->area,native_label_glyph);
+    native_label_checking=false;
+    if(!native_label_supported) return false;
+    lv_draw_opengles_unit_t * unit=(lv_draw_opengles_unit_t *)t->draw_unit;
+    lv_layer_t * layer=t->target_layer;
+    unsigned int texture=layer_get_texture(layer);
+    if(!texture) return false;
+    unsigned int framebuffer=get_framebuffer(unit);
+    GL_CALL(glBindFramebuffer(GL_FRAMEBUFFER,framebuffer));
+    GL_CALL(glFramebufferTexture2D(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,texture,0));
+    lv_opengles_viewport(0,0,lv_area_get_width(&layer->buf_area),lv_area_get_height(&layer->buf_area));
+    native_batch_task=t;
+    native_vertex_count=0;
+    lv_draw_label_iterate_characters(t,label,&t->area,native_label_glyph);
+    native_label_flush();
+    return native_label_supported;
+}
+
+static GLuint native_line_program, native_line_vao, native_line_vbo;
+static GLint native_line_endpoints, native_line_colour, native_line_radius, native_line_caps;
+
+static void native_line_cleanup(void)
+{
+    if(native_line_vbo) glDeleteBuffers(1, &native_line_vbo);
+    if(native_line_vao) glDeleteVertexArrays(1, &native_line_vao);
+    if(native_line_program) glDeleteProgram(native_line_program);
+    native_line_program = native_line_vao = native_line_vbo = 0;
+}
+
+static bool native_line_init(void)
+{
+    if(native_line_program) return true;
+    const char * vertex =
+        "attribute highp vec2 position;\n"
+        "void main(){gl_Position=vec4(position,0.0,1.0);}\n";
+    const char * fragment =
+        "precision highp float;\n"
+        "uniform vec4 endpoints,colour;\n"
+        "uniform float radius;\n"
+        "uniform vec2 caps;\n"
+        "void main(){\n"
+        " vec2 delta=endpoints.zw-endpoints.xy;\n"
+        " vec2 point=gl_FragCoord.xy-endpoints.xy;\n"
+        " float raw=dot(point,delta)/max(dot(delta,delta),0.0001);\n"
+        " float t=clamp(raw,0.0,1.0);\n"
+        " float coverage=clamp(radius+0.5-length(point-delta*t),0.0,1.0);\n"
+        " if((raw<0.0 && caps.x<0.5)||(raw>1.0 && caps.y<0.5)) coverage=0.0;\n"
+        " gl_FragColor=colour*coverage;}\n";
+    GLuint vs = gpu_shadow_compile(GL_VERTEX_SHADER, vertex);
+    GLuint fs = gpu_shadow_compile(GL_FRAGMENT_SHADER, fragment);
+    if(!vs || !fs) {
+        if(vs) glDeleteShader(vs);
+        if(fs) glDeleteShader(fs);
+        return false;
+    }
+    native_line_program = glCreateProgram();
+    glAttachShader(native_line_program, vs);
+    glAttachShader(native_line_program, fs);
+    glBindAttribLocation(native_line_program, 0, "position");
+    glLinkProgram(native_line_program);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint ok = 0;
+    glGetProgramiv(native_line_program, GL_LINK_STATUS, &ok);
+    if(!ok) { native_line_cleanup(); return false; }
+    native_line_endpoints = glGetUniformLocation(native_line_program, "endpoints");
+    native_line_colour = glGetUniformLocation(native_line_program, "colour");
+    native_line_radius = glGetUniformLocation(native_line_program, "radius");
+    native_line_caps = glGetUniformLocation(native_line_program, "caps");
+    glGenVertexArrays(1, &native_line_vao);
+    glGenBuffers(1, &native_line_vbo);
+    glBindVertexArray(native_line_vao);
+    glBindBuffer(GL_ARRAY_BUFFER, native_line_vbo);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 2 * sizeof(float), NULL);
+    return true;
+}
+
+static void native_line_segment(lv_draw_task_t * t, const lv_draw_line_dsc_t * line)
+{
+    lv_layer_t * layer = t->target_layer;
+    const float width = lv_area_get_width(&layer->buf_area);
+    const float height = lv_area_get_height(&layer->buf_area);
+    const float x1 = line->p1.x - layer->buf_area.x1 + 0.5f;
+    const float y1 = height - (line->p1.y - layer->buf_area.y1 + 0.5f);
+    const float x2 = line->p2.x - layer->buf_area.x1 + 0.5f;
+    const float y2 = height - (line->p2.y - layer->buf_area.y1 + 0.5f);
+    const float radius = line->width * 0.5f;
+    float dx=x2-x1, dy=y2-y1;
+    const float length=sqrtf(dx*dx+dy*dy);
+    if(length<=0.0001f) return;
+    dx/=length; dy/=length;
+    const float extent=radius+1.f;
+    const float px=-dy*extent, py=dx*extent;
+    const float start=line->round_start ? extent : 0.f;
+    const float end=line->round_end ? extent : 0.f;
+    const float corners[]={x1-dx*start+px,y1-dy*start+py,
+                            x2+dx*end+px,y2+dy*end+py,
+                            x2+dx*end-px,y2+dy*end-py,
+                            x1-dx*start-px,y1-dy*start-py};
+    const unsigned order[]={0,1,2,0,2,3};
+    float vertices[12];
+    for(unsigned i=0;i<6;++i) {
+        vertices[i*2]=2.f*corners[order[i]*2]/width-1.f;
+        vertices[i*2+1]=2.f*corners[order[i]*2+1]/height-1.f;
+    }
+    const float opacity = line->opa / 255.f;
+    glUniform4f(native_line_endpoints, x1,y1,x2,y2);
+    glUniform1f(native_line_radius, radius);
+    glUniform2f(native_line_caps, line->round_start, line->round_end);
+    glUniform4f(native_line_colour, line->color.blue / 255.f * opacity,
+                line->color.green / 255.f * opacity,
+                line->color.red / 255.f * opacity, opacity);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STREAM_DRAW);
+    glDrawArrays(GL_TRIANGLES, 0, 6);
+}
+
+static bool draw_native_line(lv_draw_task_t * t)
+{
+    if(t->type != LV_DRAW_TASK_TYPE_LINE) return false;
+    lv_draw_line_dsc_t * line = t->draw_dsc;
+    if(line->width <= 0 || line->opa == LV_OPA_TRANSP) return true;
+    if(line->dash_width || line->dash_gap) return false;
